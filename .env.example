# Jarvis 2.0. Settings are saved in LOCALAPPDATA/Jarvis/settings.env.

# AI POOL
JARVIS_AI=auto
JARVIS_AI_ORDER=groq,cerebras,gemini,openrouter
JARVIS_AI_MODEL=
JARVIS_GROQ_MODEL=openai/gpt-oss-20b
JARVIS_CEREBRAS_MODEL=llama3.1-8b
JARVIS_GEMINI_MODEL=gemini-3.6-flash
JARVIS_OPENROUTER_MODEL=openrouter/free

# ACTIVATION
JARVIS_NAME=Джарвис
JARVIS_WAKE_ENGINE=auto
JARVIS_WAKE_THRESHOLD=0.45
JARVIS_WAKE_PATIENCE=2
JARVIS_WAKE_FUZZY=0.70
JARVIS_MODEL_WAKE=tiny
JARVIS_MIC=
JARVIS_MIC_SENSITIVITY=3.0
JARVIS_SILENCE_TAIL=0.85

# SPEECH
JARVIS_SPEECH_MODE=auto
JARVIS_CLOUD_AUDIO=true
JARVIS_MODEL_MAIN=small
JARVIS_LIVE_TEXT=true
JARVIS_TTS=true
JARVIS_VOICE=ru-RU-DmitryNeural
JARVIS_VOICE_RATE=+10%
JARVIS_VOICE_PITCH=+0Hz

# BEHAVIOUR
JARVIS_TITLE=сэр
JARVIS_FOLLOW_UP=15
JARVIS_FOLLOW_ACTION=8
JARVIS_FOLLOW_QUESTION=25
JARVIS_UNLOAD_AFTER=180
JARVIS_CONFIRM=true
JARVIS_LEARN=true

# PRIVACY
JARVIS_REMEMBER_CHAT=false
JARVIS_ACTION_LOG_DAYS=14
JARVIS_DIAGNOSTIC_TEXT=false

# INTERFACE
JARVIS_UI=true
JARVIS_UI_POSITION=top
JARVIS_UI_THEME=dark
JARVIS_UI_ACCENT=cyan
JARVIS_REDUCED_MOTION=false

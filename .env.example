# Jarvis 4. Copy the right part into the right place. Real values never go into git (.env is ignored).
# Comments are on their own lines on purpose: systemd (EnvironmentFile) does not cut a comment off the end of a value.

# ======================================================================================================================
# SERVER: /opt/jarvis/.env (read by the systemd unit deploy/jarvis4.service)
# ======================================================================================================================

# --- required ---

# console.anthropic.com. Put a monthly limit there too.
ANTHROPIC_API_KEY=
# Your numeric Telegram id: the only person Jarvis obeys.
OWNER_TG_ID=
# my.telegram.org, for the agent's OWN Telegram account (not yours).
TG_API_ID=
TG_API_HASH=
# A long random string. The laptop's JARVIS_HANDS_TOKEN must be the same.
HANDS_TOKEN=

# One-time login of the agent's Telegram account (you type the code yourself):
#   cd /opt/jarvis && set -a && . ./.env && set +a && .venv/bin/python -m jarvis4.login

# --- optional ---

# Free tier: looks at videos, GIFs and stickers, voices the calls (Gemini Live).
GEMINI_API_KEY=
# Your phone, digits only: SMS and a robot call when Telegram does not get through.
OWNER_PHONE=
# smsc.ru (SMSC_API_KEY or SMSC_PASSWORD).
SMSC_LOGIN=
SMSC_API_KEY=
# Sites checked around the clock, comma separated.
MONITOR_SITES=https://example.com
# Other servers to watch: name=user@host, comma separated.
MONITOR_HOSTS=
# Devices and servers as JSON, see README_JARVIS4.md. For example:
#   {"android": {"target": "100.x.y.z:5555"}, "servers": {"home": {"target": "user@host", "key": "/opt/jarvis/data/keys/home", "mode": "full"}}}
JARVIS_NODES=

# --- money in dollars and behaviour (the defaults are in jarvis4/config.py) ---

# A day, on the owner's clock. /limit in Telegram moves today's line.
J4_DAILY_LIMIT=2
# Past this only the cheap model answers.
J4_SOFT_LIMIT=1.5
# Still lets the owner talk past the daily limit.
J4_OWNER_RESERVE=0.2
# One task.
J4_TASK_LIMIT=0.4
# Strangers and groups together.
J4_OTHERS_DAILY=0.4
# Actions in one task with the screen, and its dollars.
EYES_STEPS=25
EYES_TASK_LIMIT=0.5
# The owner's clock: limits reset at its midnight.
OWNER_TZ=Europe/Moscow
# 1: write to the log what would be sent, send nothing.
JARVIS_DRY_RUN=0

# ======================================================================================================================
# LAPTOP: .env next to hands.py (python-dotenv)
# ======================================================================================================================

# The same value as HANDS_TOKEN on the server.
JARVIS_HANDS_TOKEN=
# hands.py opens an SSH tunnel to the server with this account.
JARVIS_SSH=user@server
# Where the hub listens on the server (its Tailscale address and port).
JARVIS_HUB=100.x.y.z:8765
